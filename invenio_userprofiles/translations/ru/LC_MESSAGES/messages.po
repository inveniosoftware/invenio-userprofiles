#: invenio_userprofiles/forms.py:205
msgid "Profile visibility"
msgstr "Видимость профиля"

#: invenio_userprofiles/forms.py:207 invenio_userprofiles/forms.py:220
msgid "Public"
msgstr "Публичное"

#: invenio_userprofiles/forms.py:208 invenio_userprofiles/forms.py:221
msgid "Hidden"
msgstr "Скрытое"

#: invenio_userprofiles/forms.py:211
msgid ""
"Public profiles can be found by other users via searches on username, full "
"name and affiliation. Hidden profiles cannot be found by other users."
msgstr ""
"Публичные профили могут найти другие пользователи при помощи поиска по "
"псевдониму, полному имени и аффилиации. Скрытые профили не могут быть "
"обнаружены другими пользователями."

#: invenio_userprofiles/forms.py:218
msgid "Email visibility"
msgstr "Видимость электронной почты"

#: invenio_userprofiles/forms.py:224
msgid ""
"Public email visibility enables your profile to be found by your email "
"address."
msgstr ""
"Публичная видимость электронной почты позволяет найти вашу учетную запись по"
" электронному адресу."

#: invenio_userprofiles/forms.py:231
msgid "Preferences locale"
msgstr "Локаль настроек"

#: invenio_userprofiles/validators.py:17
msgid ""
"Username must start with a letter, be at least three characters long and "
"only contain alphanumeric characters, dashes and underscores."
msgstr ""
"Псевдоним пользователя должен начинаться с буквы, состоять как минимум из "
"трех символов и содержать только буквы, цифры, дефисы и нижние "
"подчеркивания."

#. NOTE: Flash message.
