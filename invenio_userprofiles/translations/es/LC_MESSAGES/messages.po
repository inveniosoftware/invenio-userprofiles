#. NOTE: Form button label
#: invenio_userprofiles/forms.py:164
msgid "Resend verification email"
msgstr "Reenviar correo de verificación"

#: invenio_userprofiles/forms.py:205
msgid "Profile visibility"
msgstr "Visibilidad del perfil"

#: invenio_userprofiles/forms.py:207 invenio_userprofiles/forms.py:220
msgid "Public"
msgstr "Publico"

#: invenio_userprofiles/forms.py:208 invenio_userprofiles/forms.py:221
msgid "Hidden"
msgstr "Oculto"

#: invenio_userprofiles/forms.py:211
msgid ""
"Public profiles can be found by other users via searches on username, full "
"name and affiliation. Hidden profiles cannot be found by other users."
msgstr ""
"Otros usuarios pueden encontrar perfiles públicos a través de búsquedas de "
"nombre de usuario, nombre completo y afiliación. Los perfiles ocultos no "
"pueden ser encontrados por otros usuarios."

#: invenio_userprofiles/forms.py:218
msgid "Email visibility"
msgstr "Visibilidad del correo"

#: invenio_userprofiles/forms.py:224
msgid ""
"Public email visibility enables your profile to be found by your email "
"address."
msgstr ""
"La visibilidad pública del correo permite que pueda encontrarse su perfil a "
"través del mismo."

#: invenio_userprofiles/forms.py:231
msgid "Preferences locale"
msgstr "Preferencias locales"

#: invenio_userprofiles/validators.py:17
msgid ""
"Username must start with a letter, be at least three characters long and "
"only contain alphanumeric characters, dashes and underscores."
msgstr ""
"El nombre de usuario debe iniciar con una letra y tener al menos tres "
"caracteres. Sólo se admiten caracteres alfanuméricos, guiones y guiones "
"bajos."

#. NOTE: Flash message.
#: invenio_userprofiles/views.py:108
msgid "Verification email sent."
msgstr "Correo de verificación enviado."

#. NOTE: Flash message after successful update of profile.
#: invenio_userprofiles/views.py:131
#, python-format
msgid ""
"Profile was updated. We have sent a verification email to %(email)s. Please "
"check it."
msgstr ""
"El perfil ha sido actualizado. Le hemos enviado un correo de verificación a "
"%(email)s. Le rogamos que lo compruebe."

#. NOTE: Flash message after successful update of profile.
#: invenio_userprofiles/views.py:139
msgid "Profile was updated."
msgstr "El perfil ha sido actualizado."

#. NOTE: Flash message after successful update of profile.
#: invenio_userprofiles/views.py:148
msgid "Preferences were updated."
msgstr "Las preferencias han sido actualizadas."

